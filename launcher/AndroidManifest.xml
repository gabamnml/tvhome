<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.binario.tvhome"
    android:versionCode="2"
    android:versionName="1.0">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only to check we're online before a weather fetch. No location
         permission: the Wi-Fi pill that needed it is gone. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Only for the weather readout. Set weather_enabled to false in
         config.xml and the launcher makes no network requests at all. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Both of these are no-ops on API 28 (package visibility starts at 30),
         but without them the grid comes up empty if this APK is ever moved to a
         newer box. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_banner"
        android:allowBackup="false"
        android:theme="@style/HomeTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
