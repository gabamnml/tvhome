# --- build output -----------------------------------------------------------
# Everything here is regenerated by tools/build-install.ps1 in ~7 seconds.
build/

# --- signing key ------------------------------------------------------------
# A debug keystore, created automatically on the first build. It never belongs
# in a repository, and committing one would mean every clone of this project
# signed its APKs with the same key.
launcher/keystore/

# --- downloaded toolchain ---------------------------------------------------
# R8 8.7.18, ~17 MB, fetched once from maven.google.com by build-install.ps1.
tools/lib/

# --- your device ------------------------------------------------------------
# IP address, SDK path, anything machine-specific. Copy device.example.ps1.
tools/device.local.ps1

# --- device dumps -----------------------------------------------------------
# backup/ is a snapshot of YOUR box: serial number, Wi-Fi MAC, android_id, the
# full settings namespaces. It is the thing restore.ps1 reads, so keep it on
# disk — but it is yours, not the project's, and it must not be published.
backup/*
!backup/.gitkeep
!backup/README.md

# --- verification screenshots -----------------------------------------------
# shot.ps1 drops raw 1080p PNGs here as you work. The curated ones that the
# documentation points at live in docs/img/ and are committed.
screenshots/

# --- editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.iml
Thumbs.db
desktop.ini
.DS_Store
